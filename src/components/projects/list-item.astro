---
import { ArrowUpRight } from '@lucide/astro';
import type { Project } from '@/data/projects';
import type { Locale } from '@/lib/i18n';
import TopicBadge from '@/components/topics/badge.astro';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
---

<li
  data-topics={project.topics.map((topic) => topic.slug).join(' ')}
  class="group bg-card hover:bg-muted/20 flex min-h-64 flex-col rounded-lg border p-5 transition-colors"
>
  <div class="flex items-start justify-between gap-4">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-muted-foreground rounded-sm border px-2 py-0.5 font-mono text-xs">
        {project.type}
      </span>
      {
        project.archived && (
          <span class="rounded-sm border border-yellow-300 bg-yellow-50 px-2 py-0.5 font-mono text-xs text-yellow-900 dark:border-yellow-800 dark:bg-yellow-950/50 dark:text-yellow-200">
            archived
          </span>
        )
      }
    </div>
    <a
      href={project.href}
      class="text-muted-foreground hover:text-foreground flex shrink-0 items-center gap-1 py-0.5 font-mono text-xs transition-colors"
      target="_blank"
      rel="noreferrer"
      aria-label={`View ${project.name} source on GitHub`}
    >
      source
      <ArrowUpRight class="size-3.5" />
    </a>
  </div>

  <div class="mt-8">
    <h3>
      <a
        href={project.href}
        class="hover:text-muted-foreground font-mono text-xl font-medium tracking-tight transition-colors"
        target="_blank"
        rel="noreferrer"
      >
        {project.name}
      </a>
    </h3>
    <p class="text-muted-foreground mt-3 text-sm leading-6">{project.description[locale]}</p>
  </div>

  <ul class="mt-auto flex flex-wrap gap-1.5 pt-8">
    {
      project.topics.map((topic) => (
        <li>
          <TopicBadge topic={topic} locale={locale} tab="projects" />
        </li>
      ))
    }
  </ul>
</li>
