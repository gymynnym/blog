---
import { projects } from '@/data/projects';
import { ui, type Locale } from '@/lib/i18n';
import PageHeading from '@/components/global/page-heading.astro';
import TopicFilter from '@/components/topics/filter.astro';
import ProjectList from '@/components/projects/list.astro';
import ProjectListItem from '@/components/projects/list-item.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<main class="mx-auto max-w-6xl p-8">
  <PageHeading title="projects:" count={projects.length} />

  <div class="mb-6"><TopicFilter locale={locale} /></div>

  <section aria-label={ui[locale].projects}>
    <ProjectList>
      {projects.map((project) => <ProjectListItem project={project} locale={locale} />)}
    </ProjectList>
  </section>
</main>
