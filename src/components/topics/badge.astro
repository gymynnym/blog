---
import { type Locale } from '@/lib/i18n';
import { postsPath, projectsPath } from '@/lib/routes';

interface Topic {
  slug: string;
  name: string;
}

interface Props {
  topic: Topic;
  locale: Locale;
  tab: 'posts' | 'projects';
  variant?: 'default' | 'overlay';
}

const { topic, locale, tab, variant = 'default' } = Astro.props;
const listPath = tab === 'posts' ? postsPath(locale) : projectsPath(locale);
const href = `${listPath}?topic=${encodeURIComponent(topic.slug)}`;
---

<a
  href={href}
  class:list={[
    'inline-flex min-h-7 items-center gap-1.5 rounded-md border px-2 py-1 text-xs leading-4 transition-colors',
    variant === 'overlay'
      ? 'border-white/15 bg-black/25 text-white backdrop-blur-md hover:bg-black/45'
      : 'bg-background text-muted-foreground hover:bg-muted hover:text-foreground',
  ]}
>
  <img
    class="size-3.5 shrink-0"
    loading="lazy"
    width="14"
    height="14"
    src={`https://pub-aa8d676a4cd044e385a97d8195986254.r2.dev/icons/${topic.slug}.svg`}
    alt=""
  />
  {topic.name}
</a>
