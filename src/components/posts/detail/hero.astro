---
import type { MarkdownHeading } from 'astro';
import { ui, type Locale } from '@/lib/i18n';

interface Props {
  thumbnail?: string;
  title: string;
  headings: MarkdownHeading[];
  locale: Locale;
}

const { thumbnail, title, headings, locale } = Astro.props;
const sectionHeadings = headings.filter(({ depth }) => depth > 1);
const topDepth = Math.min(...sectionHeadings.map(({ depth }) => depth));
const toc = sectionHeadings.filter(({ depth }) => depth === topDepth);
---

<section
  data-post-hero
  class:list={[
    'relative isolate min-h-[calc(100svh-3.5rem)] overflow-clip [clip-path:inset(0)]',
    thumbnail ? 'text-white' : 'bg-foreground text-background',
  ]}
>
  {
    thumbnail && (
      <>
        <img
          src={thumbnail}
          alt=""
          class="fixed inset-0 -z-10 h-svh w-full scale-105 object-cover blur-sm"
          aria-hidden="true"
        />
        <div class="absolute inset-0 bg-black/40" />
      </>
    )
  }

  <div
    class="relative mx-auto flex min-h-[calc(100svh-3.5rem)] max-w-5xl flex-col items-center justify-center gap-10 px-6 py-16"
  >
    <slot />

    {
      toc.length > 0 && (
        <nav aria-label={ui[locale].contents} class="w-full max-w-2xl text-sm sm:text-base">
          <ol class="space-y-2">
            {toc.map((heading, index) => (
              <li class="flex items-baseline gap-2">
                <span>[{index + 1}]</span>
                <span class="grow border-b border-dotted border-current opacity-70" />
                <a href={`#${heading.slug}`} class="transition-opacity hover:opacity-70">
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </div>

  <p class="absolute right-6 bottom-6 z-10 text-sm">
    {ui[locale].writtenBy}{' '}
    <a
      href="https://github.com/gymynnym"
      class="underline underline-offset-4 transition-opacity hover:opacity-70"
      target="_blank"
      rel="me noreferrer"
    >
      gymynnym
    </a>
  </p>
</section>
