---
import { getEntry } from 'astro:content';
import { formatDate, type Locale } from '@/lib/i18n';
import { postRoute, type Post } from '@/lib/posts';
import { postPath, seriesPath } from '@/lib/routes';
import { resolveTopics } from '@/lib/topics';
import TopicBadge from '@/components/topics/badge.astro';

interface Props {
  post: Post;
  locale: Locale;
  compact?: boolean;
}

const { post, locale, compact = false } = Astro.props;
const { slug } = postRoute(post);
const Heading = compact ? 'h3' : 'h2';
const topics = await resolveTopics(post.data.topics);
const series = post.data.series ? await getEntry(post.data.series) : undefined;
---

<li
  data-topics={topics.map((topic) => topic.slug).join(' ')}
  data-series={series?.data.slug}
  data-series-order={post.data.seriesOrder}
  class:list={[
    'group grid min-w-0 gap-5',
    compact
      ? 'content-start'
      : 'border-b pb-8 last:border-b-0 sm:grid-cols-[minmax(0,0.85fr)_minmax(0,1.5fr)] sm:gap-8',
  ]}
>
  <a
    href={postPath(locale, slug)}
    class="bg-muted relative block aspect-video overflow-hidden rounded-md border"
    aria-label={post.data.title}
  >
    {
      post.data.thumbnail ? (
        <img
          src={post.data.thumbnail}
          alt=""
          class="size-full object-cover object-center transition-transform duration-300 group-hover:scale-[1.02]"
          loading="lazy"
        />
      ) : (
        <span class="bg-foreground text-background flex size-full items-center justify-center px-6 font-mono text-lg">
          blog: gymynnym
        </span>
      )
    }
  </a>

  <div class="flex min-w-0 flex-col gap-3 sm:py-1">
    <div class="text-muted-foreground flex flex-wrap items-center gap-2 text-xs leading-5">
      <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, locale)}</time>
      {
        series && (
          <>
            <span>·</span>
            <a href={seriesPath(locale, series.data.slug)} class="hover:text-foreground transition-colors">
              {series.data.name[locale]}
            </a>
          </>
        )
      }
    </div>

    <div class="space-y-2">
      <Heading>
        <a
          href={postPath(locale, slug)}
          class:list={[
            'hover:text-muted-foreground block leading-snug font-semibold tracking-tight text-balance transition-colors',
            compact ? 'text-lg' : 'text-xl lg:text-2xl',
          ]}>{post.data.title}</a
        >
      </Heading>
      <p class="text-muted-foreground line-clamp-2 text-sm leading-6">{post.data.description}</p>
    </div>

    {
      topics.length > 0 && (
        <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
          {topics.map((topic) => (
            <TopicBadge locale={locale} topic={topic} tab="posts" />
          ))}
        </div>
      )
    }
  </div>
</li>
