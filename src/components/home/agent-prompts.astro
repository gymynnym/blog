---
import { Check, Copy } from '@lucide/astro';
import { ui, type Locale } from '@/lib/i18n';
import { homePath, postsPath, projectsPath } from '@/lib/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labels = ui[locale];
const paths = {
  home: homePath(locale),
  posts: postsPath(locale),
  projects: projectsPath(locale),
};
const prompts = labels.agentPrompts.map(({ page, message }) => ({
  message,
  url: new URL(`${paths[page]}/`, Astro.site).href,
}));
---

<div
  class="mt-5 max-w-lg"
  data-agent-prompts
  data-copy-success={labels.promptCopySuccess}
  data-copy-error={labels.promptCopyError}
>
  <p class="text-muted-foreground text-sm leading-6 sm:text-base">{labels.agentPromptsDescription}</p>
  <ul class="mt-2 -mx-2 space-y-0.5" role="list">
    {prompts.map(({ message, url }) => (
      <li>
        <button
          type="button"
          class="hover:bg-accent hover:text-accent-foreground focus-visible:outline-foreground inline-flex min-h-7.5 w-fit max-w-full cursor-pointer items-center gap-2 rounded-md px-2 py-1 text-left transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-wait"
          data-copy-prompt={`${url}\n${message}`}
          aria-label={`${labels.copyPrompt}: ${message}`}
          title={`${url}\n${message}`}
        >
          <span class="text-muted-foreground shrink-0" aria-hidden="true">
            <span class="flex items-center" data-copy-idle>
              <Copy class="size-3.5" />
            </span>
            <span class="flex items-center" data-copy-done hidden>
              <Check class="size-3.5" />
            </span>
          </span>
          <span class="min-w-0 select-text" data-prompt-text>
            <span class="block text-sm leading-5">{message}</span>
            <span class="text-muted-foreground mt-1 block font-mono text-xs leading-5 break-all" data-prompt-url hidden>
              {url}
            </span>
          </span>
        </button>
      </li>
    ))}
  </ul>
  <p
    class="text-muted-foreground mt-1 text-xs leading-5 empty:hidden"
    role="status"
    aria-atomic="true"
    data-copy-status
  ></p>
</div>

<script>
  for (const container of document.querySelectorAll<HTMLElement>('[data-agent-prompts]')) {
    const status = container.querySelector<HTMLElement>('[data-copy-status]');

    for (const button of container.querySelectorAll<HTMLButtonElement>('[data-copy-prompt]')) {
      const idle = button.querySelector<HTMLElement>('[data-copy-idle]');
      const done = button.querySelector<HTMLElement>('[data-copy-done]');
      const url = button.querySelector<HTMLElement>('[data-prompt-url]');
      let resetTimer: number | undefined;

      button.addEventListener('click', async () => {
        const prompt = button.dataset.copyPrompt;
        if (!prompt) return;

        window.clearTimeout(resetTimer);
        button.disabled = true;
        if (status) status.textContent = '';

        try {
          await navigator.clipboard.writeText(prompt);
          if (idle) idle.hidden = true;
          if (done) done.hidden = false;
          if (url) url.hidden = true;
          if (status) status.textContent = container.dataset.copySuccess ?? '';
          resetTimer = window.setTimeout(() => {
            if (idle) idle.hidden = false;
            if (done) done.hidden = true;
          }, 2000);
        } catch {
          if (idle) idle.hidden = false;
          if (done) done.hidden = true;
          if (url) url.hidden = false;
          if (status) status.textContent = container.dataset.copyError ?? '';

          const text = button.querySelector('[data-prompt-text]');
          const selection = window.getSelection();
          if (text && selection) {
            const range = document.createRange();
            range.selectNodeContents(text);
            selection.removeAllRanges();
            selection.addRange(range);
          }
        } finally {
          button.disabled = false;
        }
      });
    }
  }
</script>
