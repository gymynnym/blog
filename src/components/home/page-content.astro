---
import AgentPrompts from '@/components/home/agent-prompts.astro';
import HeroBackground from '@/components/home/hero-background.astro';
import RecentPosts from '@/components/home/recent-posts.astro';
import TopicBadge from '@/components/topics/badge.astro';
import { ui, type Locale } from '@/lib/i18n';
import { publishedPosts } from '@/lib/posts';
import { resolveTopics } from '@/lib/topics';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const posts = await publishedPosts(locale);
const topicReferences = new Map(
  posts.flatMap((post) => (post.data.topics ?? []).map((topic) => [topic.id, topic] as const)),
);
const topics = (await resolveTopics([...topicReferences.values()])).sort((a, b) =>
  a.name.localeCompare(b.name, locale),
);
const title = 'gymynnym';
---

<main>
  <section class="home-hero" aria-labelledby="home-title">
    <HeroBackground />
    <h1 id="home-title" class="font-mono" aria-label={title}>
      <svg viewBox="0 -8 1000 152" aria-hidden="true" focusable="false">
        <text x="2" y="96" textLength="996" lengthAdjust="spacingAndGlyphs">
          {title}
        </text>
      </svg>
    </h1>
    <AgentPrompts locale={locale} />
    {topics.length > 0 && (
      <nav class="home-topics" aria-labelledby="home-topics-label">
        <p id="home-topics-label" class="text-muted-foreground text-center text-sm">
          {ui[locale].browseByTopic}
        </p>
        <div class="flex flex-wrap justify-center gap-2">
          {topics.map((topic) => (
            <TopicBadge locale={locale} topic={topic} tab="posts" />
          ))}
        </div>
      </nav>
    )}
  </section>
  <RecentPosts posts={posts} locale={locale} />
</main>

<style>
  .home-hero {
    --header-height: 3.5rem;
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: calc(100svh - var(--header-height));
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(max-content, 1fr) auto minmax(max-content, 1fr);
    justify-items: center;
    gap: 2rem;
    overflow-x: clip;
    padding-block: 1rem calc(1rem + var(--header-height));
    padding-inline: clamp(1rem, 5vw, 3rem);
  }

  .home-topics {
    display: grid;
    width: min(100%, 68rem);
    align-self: end;
    gap: 0.75rem;
    margin-bottom: calc(-1 * var(--header-height));
  }

  h1 {
    width: 100%;
  }

  svg {
    width: 100%;
    fill: currentColor;
    font-size: 160px;
    font-weight: 700;
    letter-spacing: -0.025em;
  }
</style>
