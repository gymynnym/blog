---
import '@/styles/global.css';
import GlobalHeader from '@/components/global/header.astro';
import GlobalFooter from '@/components/global/footer.astro';
import { localeFromPath, ui, type LanguageLinks, type Locale } from '@/lib/i18n';
import { feedPath } from '@/lib/routes';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  languageLinks?: LanguageLinks;
}

const {
  title,
  description = 'gymynnym blog',
  locale = localeFromPath(Astro.url.pathname),
  languageLinks,
} = Astro.props;
const documentTitle = title ? `${title} | gymynnym` : 'gymynnym | blog';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="https://avatars.githubusercontent.com/u/118962415" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${documentTitle} RSS`} href={feedPath(locale)} />
    {
      languageLinks &&
        Object.entries(languageLinks).map(([language, href]) => (
          <link rel="alternate" hreflang={language} href={new URL(href, Astro.site ?? Astro.url).href} />
        ))
    }
    <title>{documentTitle}</title>
  </head>
  <body class="bg-background text-foreground flex min-h-svh flex-col">
    <a
      href="#main-content"
      class="bg-foreground text-background fixed top-3 left-3 z-[100] -translate-y-20 rounded-md px-4 py-3 text-sm focus:translate-y-0"
      >{ui[locale].skipToContent}</a
    >
    <GlobalHeader locale={locale} languageLinks={languageLinks} />
    <div id="main-content" class="flex-1" tabindex="-1"><slot /></div>
    <GlobalFooter locale={locale} />
  </body>
</html>
