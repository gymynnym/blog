---
import '@/styles/global.css';
import GlobalHeader from '@/components/global/header.astro';
import { localeFromPath, type LanguageLinks, type Locale } from '@/lib/i18n';
import { feedPath } from '@/lib/routes';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  languageLinks?: LanguageLinks;
}

const {
  title,
  description = 'gymynnym blog',
  locale = localeFromPath(Astro.url.pathname),
  languageLinks,
} = Astro.props;
const documentTitle = title ? `${title} | gymynnym` : 'gymynnym | blog';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="https://avatars.githubusercontent.com/u/118962415" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title={`${documentTitle} RSS`} href={feedPath(locale)} />
    {
      languageLinks &&
        Object.entries(languageLinks).map(([language, href]) => (
          <link rel="alternate" hreflang={language} href={href} />
        ))
    }
    <title>{documentTitle}</title>
  </head>
  <body class="bg-background text-foreground pt-14">
    <GlobalHeader locale={locale} languageLinks={languageLinks} />
    <slot />
  </body>
</html>
