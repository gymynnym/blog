---
import HomePageContent from '@/components/home/page-content.astro';
import GlobalLayout from '@/layouts/global.astro';
import { defaultLocale, locales, ui, type LanguageLinks } from '@/lib/i18n';
import { homePath } from '@/lib/routes';

const languageLinks = Object.fromEntries(locales.map((locale) => [locale, homePath(locale)])) as LanguageLinks;
---

<GlobalLayout description={ui[defaultLocale].blogDescription} locale={defaultLocale} languageLinks={languageLinks}>
  <HomePageContent locale={defaultLocale} />
</GlobalLayout>
