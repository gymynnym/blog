{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "mdx:check": "go -C scripts run ./mdx-spacing",
    "mdx:fix": "go -C scripts run ./mdx-spacing --fix",
    "test:mdx": "go -C scripts test ./mdx-spacing",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@lucide/astro": "^1.70.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "~7.0.2"
  }
}
